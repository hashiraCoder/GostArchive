# ── Backend server ────────────────────────────────────────────────────────────

GHOSTARCHIVE_HOST=127.0.0.1
GHOSTARCHIVE_PORT=8000

# ── Data directory ────────────────────────────────────────────────────────────

GHOSTARCHIVE_DATA_DIR=backend/data

# ── Upload limits ─────────────────────────────────────────────────────────────

UPLOAD_MAX_BYTES=5242880
EXTRACTED_TEXT_MAX_CHARS=500000

# ── Local language model (Ollama) ─────────────────────────────────────────────

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=60

# ── LLM Provider (Local Ollama default; Optional External API) ────────────────
GHOSTARCHIVE_LLM_PROVIDER=ollama
GHOSTARCHIVE_EXTERNAL_API_KEY=
GHOSTARCHIVE_EXTERNAL_MODEL=gemini-2.5-flash
GHOSTARCHIVE_EXTERNAL_API_BASE_URL=

# ── Local embedding model (Sentence Transformers) ─────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval settings ────────────────────────────────────────────────────────

RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_MAX=8
RETRIEVAL_MIN_SIMILARITY=0.30
RETRIEVAL_LEXICAL_BOOST=true

# ── CORS ──────────────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

