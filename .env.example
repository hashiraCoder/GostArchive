# GhostArchive environment configuration
# Copy this file to .env and fill in any values you need to override.
# Never commit .env to source control.
# All defaults below work for local development with no changes required
# unless your paths or model choices differ.

# ── Backend server ────────────────────────────────────────────────────────────
# Bind address — MUST stay at 127.0.0.1 for local-only access (see AGENTS.md)
GHOSTARCHIVE_HOST=127.0.0.1
GHOSTARCHIVE_PORT=8000

# ── Data directory ────────────────────────────────────────────────────────────
# Absolute or relative path for all runtime data: SQLite DB, uploaded files,
# ChromaDB index. This directory is excluded from git. Created automatically.
GHOSTARCHIVE_DATA_DIR=backend/data

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum bytes per uploaded file (default 5 MiB)
UPLOAD_MAX_BYTES=5242880
# Maximum extracted plain-text characters per document
EXTRACTED_TEXT_MAX_CHARS=500000

# ── Local language model (Ollama) ─────────────────────────────────────────────
# Base URL for your local Ollama instance. Must be loopback; do not point to a
# remote or cloud endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model tag to use for generation. First run requires `ollama pull <model>`.
# Gemma 3 is subject to Google's Gemma Terms of Use (not OSI-approved open source).
OLLAMA_MODEL=gemma3:1b
# Request timeout in seconds for Ollama generation calls
OLLAMA_TIMEOUT_SECONDS=60

# ── LLM Provider (Local Ollama default; Optional External API) ────────────────
# Default: "ollama" (100% offline, private, loopback only).
# Optional: "external" to connect to an OpenAI-compatible / Gemini endpoint.
# WARNING: Setting "external" transmits retrieved passages across the network.
GHOSTARCHIVE_LLM_PROVIDER=ollama
GHOSTARCHIVE_EXTERNAL_API_KEY=
GHOSTARCHIVE_EXTERNAL_MODEL=gemini-2.5-flash
GHOSTARCHIVE_EXTERNAL_API_BASE_URL=

# ── Local embedding model (Sentence Transformers) ─────────────────────────────
# Model name as passed to sentence-transformers. Downloaded on first use from
# Hugging Face; verify the license (Apache-2.0 for all-MiniLM-L6-v2).
# After first download, offline use is supported.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval settings ────────────────────────────────────────────────────────
# Default number of chunks to retrieve per query (clamped to 1–8)
RETRIEVAL_TOP_K=5
# Hard cap on top_k even if the client requests more
RETRIEVAL_TOP_K_MAX=8
# Minimum cosine similarity threshold (calibrated 0.30; rejects out-of-domain noise)
RETRIEVAL_MIN_SIMILARITY=0.30
# Enable SQLite FTS5 lexical retrieval boost with Reciprocal Rank Fusion
RETRIEVAL_LEXICAL_BOOST=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins for the API. Must match your Vite dev server URL.
# Do not add external origins; this API must not be exposed to the internet.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Never log extracted document text, prompts, or model output at any level.
